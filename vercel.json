{
  "$schema": "https://vercel.com/schema/project.json",
  "version": 3,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "HF_MODEL_ID": {
      "target": ["production", "preview", "development"],
      "sensitivity": "non_secret"
    },
    "HF_TOKEN": {
      "target": ["production", "preview", "development"],
      "sensitivity": "secret"
    }
  }
}
