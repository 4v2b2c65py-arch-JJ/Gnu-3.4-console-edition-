# Leviathan Landing Page — Environment Configuration

# Hugging Face model (replaces Kimi API)
# Example: meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, etc.
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Hugging Face access token (optional — enables gated/model downloads)
HF_TOKEN=hf_your_token_here

# Asset replication (legacy, no longer required for AI status)
KIMI_API_KEY=
