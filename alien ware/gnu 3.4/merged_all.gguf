import os, json, hashlib

FOLDER = "alien ware\\gnu 3.4"
VAULT = {"registry_auto": "HKCU\\Software\\AlienWare", "vault_preset": "machine-default"}

def checksum_blob(data):
    return hashlib.sha256(data).hexdigest()

for i in range(1, 21):
    path = os.path.join(FOLDER, f"{i}.gguf")
    with open(path, "rb") as fh:
        data = fh.read()
    blob = checksum_blob(data)
    record = {
        "registry_key": VAULT["registry_auto"],
        "vault_preset": VAULT["vault_preset"],
        "checksum_blob": blob,
        "rollback": True,
        "auto": True,
    }
    out = os.path.join(FOLDER, f"{i}_registry.json")
    with open(out, "w") as fh:
        json.dump(record, fh, indent=2)
    print(f"{i}.gguf: registry blob {blob[:12]}... rollback ready")

print("done")
import os, json, hashlib

FOLDER = "alien ware\\gnu 3.4"
ROUTES = ["usb", "ssd", "nvme", "sdcard", "network"]

for i in range(1, 21):
    path = os.path.join(FOLDER, f"{i}.gguf")
    with open(path, "rb") as fh:
        data = fh.read()
    archive_hash = hashlib.sha256(data).hexdigest()
    record = {
        "shade_package": "pacman",
        "data_path_preset": path,
        "disk_types": "any",
        "auto_registry": True,
        "ip_blocks": False,
        "routes": ROUTES,
        "image_feed": "read image sent through path preset to all detected routes",
        "digital_archive": archive_hash,
        "checksum_rule": "auto rule out possibilities and variants",
    }
    out = os.path.join(FOLDER, f"{i}_shade.json")
    with open(out, "w") as fh:
        json.dump(record, fh, indent=2)
    print(f"{i}.gguf: shade archive {archive_hash[:12]}... routes={len(ROUTES)}")

print("done")
import os
import struct

FOLDER = "alien ware\\gnu 3.4"
OS_GATES = ["mac", "linux", "windows", "steamdeck", "ps4", "ps5", "xbox_series"]

def raw_feed_stream(path):
    with open(path, "rb") as fh:
        return fh.read()

def image_packet_gate(data, os_name):
    # Simulate hardware access gate per OS
    magic = data[:4]
    return len(data) > 0 and magic is not None

def run_suite():
    results = []
    for os_name in OS_GATES:
        for i in range(1, 21):
            path = os.path.join(FOLDER, f"{i}.gguf")
            data = raw_feed_stream(path)
            ok = image_packet_gate(data, os_name)
            results.append((os_name, i, ok))
            print(f"[{os_name}] packet {i}: {'PASS' if ok else 'FAIL'}")
    passed = sum(1 for r in results if r[2])
    print(f"Suite: {passed}/{len(results)} passed")
    return passed == len(results)

if __name__ == "__main__":
    run_suite()
