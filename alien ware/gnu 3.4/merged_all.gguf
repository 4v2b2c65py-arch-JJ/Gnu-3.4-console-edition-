print("done")
# Boot image / OS layer sources (GitHub)

## Console BIOS/firmware packs
- https://github.com/Abdess/retrobios
  - Install: curl -fsSL https://raw.githubusercontent.com/Abdess/retrobios/main/install.sh | sh
  - Windows: irm https://raw.githubusercontent.com/Abdess/retrobios/main/install.ps1 | iex
  - Termux: curl -fsSL https://raw.githubusercontent.com/Abdess/retrobios/main/install.sh | sh

## Termux boot
- https://github.com/termux/termux-boot
  - Install from F-Droid or GitHub Actions debug builds.

## Linux on Android / Termux-style
- https://github.com/ichit/alpine-term
- https://github.com/mekhontsev/magicdesk (install_linux.sh)

## Install commands
# Linux/macOS/Steam Deck
curl -fsSL https://raw.githubusercontent.com/Abdess/retrobios/main/install.sh | sh

# Windows PowerShell
irm https://raw.githubusercontent.com/Abdess/retrobios/main/install.ps1 | iex

# Termux
pkg install python termux-setup-storage
curl -fsSL https://raw.githubusercontent.com/Abdess/retrobios/main/install.sh | sh

# MagicDesk Linux installer
magicdesk download https://raw.githubusercontent.com/mekhontsev/magicdesk/main/scripts/install_linux.sh
sh ~/install_linux.sh
while ($true) {
    $sum = 0
    Get-ChildItem -Path "alien ware\gnu 3.4\*.gguf" | ForEach-Object {
        $c = [System.IO.File]::ReadAllText($_.FullName)
        $nums = [regex]::Matches($c, '\d+') | ForEach-Object { [int]$_.Value }
        $p = ($nums | Measure-Object -Sum).Sum
        $sum += $p
        Write-Host "$($_.Name): context partial $p"
    }
    Write-Host "TOTAL CONTEXT INT: $sum"
    Start-Sleep -Seconds 5
}
const fs = require('fs');
const path = 'alien ware/gnu 3.4';
let total = 0;
for (let i = 1; i <= 20; i++) {
  const data = fs.readFileSync(`${path}/${i}.gguf`, 'utf8');
  const nums = data.match(/\d+/g) || [];
  const partial = nums.reduce((a, b) => a + parseInt(b, 10), 0);
  total += partial;
  console.log(`${i}.gguf: context partial ${partial}`);
}
console.log(`TOTAL CONTEXT INT: ${total}`);
import os
import re

FOLDER = "alien ware\\gnu 3.4"
context_int = 0
for i in range(1, 21):
    path = os.path.join(FOLDER, f"{i}.gguf")
    with open(path, "rb") as fh:
        data = fh.read().decode("utf-8", errors="ignore")
    nums = re.findall(r"\d+", data)
    context_int += sum(int(n) for n in nums)
    print(f"{i}.gguf: context partial {sum(int(n) for n in nums)}")

print(f"TOTAL CONTEXT INT: {context_int}")
import os, json

FOLDER = "alien ware\\gnu 3.4"
ENV_PRESET = {
    "rule_authority": "gguf",
    "env_preset": "roll-in",
    "python_safe": True,
    "break_on_error": False,
}

for i in range(1, 21):
    path = os.path.join(FOLDER, f"{i}.gguf")
    with open(path, "ab") as fh:
        fh.write(b"\n--ENV_PRESET--\n")
        fh.write(json.dumps(ENV_PRESET).encode() + b"\n")
    print(f"{i}.gguf: env preset rolled in")

print("done")
